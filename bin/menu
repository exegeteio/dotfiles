#!/usr/bin/env bash
# mise installs only the `fzf` binary, without the `fzf-tmux` script. The
# built-in `--tmux` option draws the same popup. fzf ignores the option outside
# of tmux.
if command -v fzf >/dev/null 2>&1; then
  exec fzf --tmux center,75% -0 -1 -m --bind ctrl-a:select-all -q "$*"
else
  in=$(</dev/stdin)
  if [[ -z "$in" ]]; then
    echo "menu - nothing to display"
    exit 1
  fi
  readarray lines <<< $in
  if [[ "${#lines[@]}" == "1" ]]; then
    echo "${lines[0]}"
  else
    IFS=$'\n'
    select sel in ${lines[@]}; do
      echo "$sel"
      exit
    done < /dev/tty
  fi
fi
