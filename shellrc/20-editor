#!/usr/bin/env bash
# Choose the default editor. Run `editor <name>` to change it in the shell.

editor() {
  case "$1" in
    rubymine) EDITOR='rubymine'; EDITOR_ARGS='rubymine.args' ;;
    code) EDITOR='code -wr'; EDITOR_ARGS='code.args' ;;
    nvim | vim) EDITOR="$1"; EDITOR_ARGS='vi.args' ;;
    *) echo "Must choose one of:  rubymine, code, nvim, vim" >&2; return 1 ;;
  esac
  export EDITOR EDITOR_ARGS
}

if [ -z "$EDITOR" ]; then
  if [ -n "$IDEA_INITIAL_DIRECTORY" ]; then
    # The bundle ID of the JetBrains IDE ends with the name of its command.
    ide=$(echo "$__CFBundleIdentifier" | sed 's/.*\.//' | tr '[:upper:]' '[:lower:]')
    if command -v "$ide" >/dev/null 2>&1; then
      export EDITOR="$ide"
      export EDITOR_ARGS="rubymine.args"
    fi
    unset ide
  elif [ "$TERM_PROGRAM" = "vscode" ]; then
    editor code
  elif command -v nvim >/dev/null 2>&1; then
    editor nvim
  else
    editor vim
  fi
fi
