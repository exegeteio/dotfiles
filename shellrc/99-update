#!/usr/bin/env bash
# Update the dotfiles one time each day. The update runs in the background.

tmp="/tmp/dotfiles-update_$(date +%F).log"

if [ ! -e "$tmp" ] && [ -e "$HOME/.config/dotfiles/.git" ]; then
  # The outer subshell prevents the job notice in an interactive shell.
  (
    cd "$HOME/.config/dotfiles" || exit 1
    { git bstash; git pull; git stash pop; } >> "$tmp" 2>&1 &
  )
fi
