#!/usr/bin/env bash
# Shared environment. Bash and zsh both source this file.

# Name of the running shell. Other files use it to run `tool init $_sh`.
if [ -n "${ZSH_VERSION-}" ]; then _sh=zsh; else _sh=bash; fi

export XDG_CONFIG_HOME="$HOME/.config"
export DOTFILES_PATH="$XDG_CONFIG_HOME/dotfiles"
export PATH="$HOME/bin:$DOTFILES_PATH/bin:$HOME/.cargo/bin:$HOME/go/bin:$HOME/code/go/bin:${XDG_DATA_HOME:-$HOME/.local/share}/mise/shims:$HOME/.brew/bin:/opt/homebrew/bin:$PATH"
export CDPATH="$HOME:$HOME/code"

# For tmux workspaces.
export CODE_PATH="${CODE_PATH:-$HOME/code}"

command -v bat >/dev/null 2>&1 && export PAGER="bat --plain"

# The 1Password agent holds the SSH keys on macOS.
if [ "$(uname)" = Darwin ]; then
  export SSH_AUTH_SOCK="$HOME/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
fi

alias act='docker run -v $(pwd):/app -v /var/run/docker.sock:/var/run/docker.sock act-docker'

# Remove the duplicate entries from PATH. The first entry of each path stays.
if [ "$_sh" = zsh ]; then
  typeset -U path
else
  _dedupe_path() {
    local entry out=""
    local IFS=:
    for entry in $PATH; do
      case ":$out:" in
        *":$entry:"*) ;;
        *) out="${out:+$out:}$entry" ;;
      esac
    done
    PATH="$out"
  }
  _dedupe_path
  unset -f _dedupe_path
fi

# mise manages the language runtimes through shims only. A full `mise activate`
# writes the real tool directories into PATH, and apps launched from that shell
# inherit them ahead of the shims, so they ignore .ruby-version. MISE_SHELL leaks
# into child shells, but the mise function does not, so test for the function.
if command -v mise >/dev/null 2>&1 && ! typeset -f mise >/dev/null 2>&1; then
  eval "$(mise activate "$_sh" --shims)"
fi

# Keep the custom commands ahead of the system paths. In zsh, the first prompt
# hook of mise rebuilds PATH and moves $DOTFILES_PATH/bin behind /usr/bin, so
# these hooks restore the order.
if [ "$_sh" = zsh ]; then
  _dotfiles_path_first() {
    path=("$HOME/bin" "$DOTFILES_PATH/bin" "${(@)path:#($HOME/bin|$DOTFILES_PATH/bin)}")
  }
  precmd_functions+=(_dotfiles_path_first)
  chpwd_functions+=(_dotfiles_path_first)
fi
