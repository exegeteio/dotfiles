#!/usr/bin/env bash

[ -z "$DEBUG" ] || echo "Setting up ENV..."
export XDG_CONFIG_HOME="$HOME/.config"
export DOTFILES_PATH="$XDG_CONFIG_HOME/dotfiles"
export PATH="$HOME/bin:$DOTFILES_PATH/bin:$HOME/.cargo/bin:$HOME/.brew/bin:$HOME/go/bin:$HOME/code/go/bin:$HOME/.rbenv/shims:$HOME/.deno/bin:$PATH"
export CDPATH="$HOME:$HOME/code"

# For tmux workspaces.
if [ -z "$CODE_PATH" ]; then
  export CODE_PATH="$HOME/code"
fi

if command -v go >/dev/null 2>&1; then
  export GOPATH="$HOME/go"
  export GOBIN="$GOPATH/bin"
  export PATH="$GOBIN:$PATH"
fi

command -v bat >/dev/null 2>&1 && export PAGER="bat --plain"

# Only init rbenv once per shell. RBENV_SHELL is exported, so it leaks into
# child shells and through the tmux exec in 01-tmux; the rbenv() function does
# not. Guard on the function so every new shell inits, but a re-sourced 00-env
# (bashrc cats it twice) does not. --no-rehash drops a ~50ms rehash per shell;
# run `rbenv rehash` by hand after installing gem binstubs.
if command -v rbenv >/dev/null 2>&1; then
  if [ -n "${ZSH_VERSION-}" ]; then
    [[ -n ${functions[rbenv]} ]] || eval "$(rbenv init - --no-rehash zsh)"
  else
    declare -F rbenv >/dev/null || eval "$(rbenv init - --no-rehash bash)"
  fi
fi

[ -z "$DEBUG" ] || echo "Done setting up ENV..."
