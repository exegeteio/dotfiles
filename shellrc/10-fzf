#!/usr/bin/env bash
# Options for fzf. The bashrc and the zshrc load the key bindings themselves,
# after the vi key bindings, so the fzf bindings win.

# Do not set FZF_TMUX_OPTS. The key bindings call the `fzf-tmux` script when
# that variable holds a value, but mise installs only the `fzf` binary. Use the
# built-in `--tmux` option instead. fzf ignores the option outside of tmux.
export FZF_DEFAULT_OPTS="--tmux center,75%"
unset FZF_TMUX_OPTS
