#!/usr/bin/env bash

[ -z "$DEBUG" ] || echo "Setting up fzf options..."
# This block read $RBENV_SHELL before mise replaced rbenv. Name the shell here
# instead, so no version manager owns this value.
if [ -n "${ZSH_VERSION-}" ]; then
  fzf_shell="zsh"
else
  fzf_shell="bash"
fi
if [[ -f "$HOME/.fzf.$fzf_shell" ]]; then
  export FZF="$(command -v fzf)"
  source "$HOME/.fzf.$fzf_shell"
fi
unset fzf_shell
if [[ -z "$TMUX" ]]; then
  export FZF_TMUX_OPTS=""
else
  export FZF_TMUX_OPTS="-p 75%"
fi
[ -z "$DEBUG" ] || echo "Done setting up fzf options..."
