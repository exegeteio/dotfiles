#!/usr/bin/env bash
# Start tmux in each new interactive shell when all of these conditions are true:
# - The tmux command exists.
# - The shell is not in tmux, VS Code, or a JetBrains environment checker.
# - The file ~/.auto_tmux exists.
# - SKIP_TMUX is not set.

if [[ -z "${SKIP_TMUX}${TMUX}${VSCODE_PID}" ]] && command -v tmux >/dev/null 2>&1 && [[ -f "$HOME/.auto_tmux" ]]; then
  if [[ -z "$SSH_CLIENT" ]]; then
    cur_path=$(realpath -q "$(pwd)" 2>&1)
    code_path=$(realpath -q "$HOME/code/" 2>&1)
    if [[ "$cur_path" == $code_path* ]]; then
      exec tmux.re "$cur_path"
    else
      exec tmux.re "main"
    fi
  else
    exec tmux.re "$(whoami 2>&1)"
  fi
fi
