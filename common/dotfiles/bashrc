#!/usr/bin/env bash
# The shared files in shellrc/ hold the settings for bash and zsh. This file
# holds the settings that only bash uses.

# Do nothing in a shell that is not interactive.
[[ $- == *i* ]] || return

# Silence the warning on macOS.
export BASH_SILENCE_DEPRECATION_WARNING=1

shellrc="${XDG_CONFIG_HOME:-$HOME/.config}/dotfiles/shellrc"
for rcfile in "$shellrc"/[0-9]*; do
  [[ -f "$rcfile" ]] && source "$rcfile"
done

# Completion.
for completion in /opt/homebrew/etc/profile.d/bash_completion.sh /usr/share/bash-completion/bash_completion; do
  [[ -r "$completion" ]] && { source "$completion"; break; }
done

# History.
HISTSIZE=50000
HISTFILESIZE=50000
HISTCONTROL=ignoreboth
shopt -s histappend

# Vi mode. The file ~/.inputrc sets the keys, and `set -o vi` sets the mode.
set -o vi

# Load the fzf bindings last, so that they replace the bindings in ~/.inputrc.
command -v fzf >/dev/null 2>&1 && eval "$(fzf --bash)"

[[ -f "$HOME/.shellrc.local" ]] && source "$HOME/.shellrc.local"
