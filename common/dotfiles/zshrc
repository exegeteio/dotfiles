#!/usr/bin/env zsh
# The shared files in shellrc/ hold the settings for bash and zsh. This file
# holds the settings that only zsh uses.

shellrc="${XDG_CONFIG_HOME:-$HOME/.config}/dotfiles/shellrc"
for rcfile in "$shellrc"/[0-9]*(N); do
  source "$rcfile"
done

# Completion. Run compinit before the fzf completion loads.
autoload -Uz compinit
compinit

# History.
HISTFILE="$HOME/.zsh_history"
HISTSIZE=50000
SAVEHIST=50000
setopt APPEND_HISTORY HIST_IGNORE_DUPS HIST_IGNORE_SPACE

# Vi mode. The bash settings for the same keys are in ~/.inputrc.
bindkey -v
export KEYTIMEOUT=1 # Hundredths of a second.

# Go to command mode with Control-J.
bindkey '^j' vi-cmd-mode
# Open the command line in the editor. Vi mode uses `v` for visual mode.
bindkey -M vicmd "^V" edit-command-line

# Search the history.
bindkey "^P" history-search-backward
bindkey "^N" history-search-forward
bindkey -M vicmd '?' history-incremental-search-backward
bindkey -M vicmd '/' history-incremental-search-forward
bindkey -M viins '^R' history-incremental-pattern-search-backward
bindkey -M viins '^F' history-incremental-pattern-search-forward

# Load the fzf bindings last, so that they replace the bindings above.
command -v fzf >/dev/null 2>&1 && source <(fzf --zsh)

[[ -f "$HOME/.shellrc.local" ]] && source "$HOME/.shellrc.local"
